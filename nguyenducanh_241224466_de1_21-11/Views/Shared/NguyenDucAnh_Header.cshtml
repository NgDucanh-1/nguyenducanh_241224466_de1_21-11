@inject QLTaiSanContext db

<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span><a asp-controller="TaiSan" asp-action="Create">Thêm tài sản</a> &nbsp;|&nbsp; Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a asp-controller="Home" asp-action="Index">Nguyễn Đức Anh</a></li>
                @foreach (var l in db.LoaiTaiSans.OrderBy(x => x.MaLoai))
                {
                    <li><a href="#" class="loai-link"
                           data-url="@Url.Action("TaiSanTheoLoai", "Home", new { maLoai = l.MaLoai })">@l.TenLoai</a></li>
                }
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>