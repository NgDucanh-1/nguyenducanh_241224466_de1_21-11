@model IEnumerable<TaiSan>

<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
</div>
<div class="grid">
    @foreach (var t in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@t.Anh" alt="@t.TenTs" /></a>
            <h2>@t.TenTs</h2>
            <div class="asset-foot"><span class="price">@(t.NguyenGia == null ? "Chưa định giá" : t.NguyenGia.Value.ToString("N0") + " tr")</span><button class="btn-buy">Chi tiết</button></div>
        </div>
    }
</div>